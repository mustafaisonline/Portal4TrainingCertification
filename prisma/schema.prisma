// Prisma schema — the PHYSICAL data model.
//
// ⚠ Every model here is a table. Adding, removing or changing one is a RED
// gate under CLAUDE.md Rule 1: it must appear in an accepted milestone
// execution plan (with its columns listed) before the migration is written,
// and the migration is applied deliberately, never automatically on deploy
// (ADR-029). Migrations are forward-only. Seed data lives in prisma/seed.ts,
// never in a migration (ADR-023/029).
//
// Generator: Prisma 7's `prisma-client` (TypeScript output, driver-adapter
// based — see src/db/prisma.ts). Output is gitignored and regenerated by
// `npm run db:generate`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Emit `./enums.ts`-style imports inside the generated client so plain
  // `node` (the seed runner) can resolve them as well as Next.js, Vitest and
  // Playwright. Without this, a `moduleResolution: bundler` tsconfig makes the
  // generator emit extensionless specifiers that only bundlers understand.
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Knowledge domain — the smallest real entity in the approved conceptual
/// model (MVP Spec §8 row 0; DATA_ARCHITECTURE.md §3.4). Approved for
/// Milestone 1 as its single table (MILESTONE_1_EXECUTION_PLAN.md §5.4):
/// exactly these columns and nothing more. The pilot domain is DATA, never a
/// constant in code (ADR-023 / BR-5).
model Domain {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  programmes          Programme[]
  diagnosticQuestions DiagnosticQuestion[]

  @@map("domains")
}

// ─────────────────────────────────────────────────────────────────────────────
// Milestone 2 — Identity & access (MILESTONE_2_EXECUTION_PLAN.md §5).
// ─────────────────────────────────────────────────────────────────────────────

// ── 5.1  Tables Better Auth owns — authentication only ───────────────────────
// Column set = Better Auth 1.7.5's core schema for `emailAndPassword` +
// `twoFactor` + database rate limiting, printed from `getAuthTables()` on
// 2026-09-21 and mapped to snake_case. Better Auth generates the text ids.
// RULE (DECISION_B §B, condition 3): no business table ever references an
// `auth_*` row. The only bridge is `auth_identities.provider_subject`.

model AuthUser {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  /// Input carrier only: collected at registration (the reviewed form has it)
  /// and copied to `users.country` by the mapping hook. Not read afterwards.
  country          String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions   AuthSession[]
  accounts   AuthAccount[]
  twoFactors AuthTwoFactor[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// scrypt hash for the email+password credential (Better Auth default).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

/// UNUSED since 2026-09-21: two-factor authentication was removed for MVP 1
/// by founder decision. Kept (with `AuthUser.twoFactorEnabled`) because
/// dropping is a destructive migration needing separate approval.
model AuthTwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  user                    AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  @@index([secret])
  @@index([userId])
  @@map("auth_two_factors")
}

model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

// ── 5.2  Tables we own — business identity, authorisation, audit, email ──────

/// THE business identity. One person, one account. Immutable UUID that every
/// future business table references (ADR-020, AP-04; DECISION_B §B).
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lower-cased by the identity service.
  email           String    @unique
  name            String
  country         String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities    AuthIdentity[]
  roles         UserRole[]
  consents      Consent[]
  orders        Order[]
  registrations Registration[]
  profile       UserProfile?
  reviews       Review[]
  certificates  Certificate[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Milestone 5a — User profile (USER_PROFILE_REQUIREMENTS.md §8;
// MILESTONE_5A_EXECUTION_PLAN.md §4). One row per user, created on first save.
// ─────────────────────────────────────────────────────────────────────────────

enum IdDocumentType {
  nric
  passport

  @@map("id_document_type")
}

model UserProfile {
  userId             String          @id @map("user_id") @db.Uuid
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// As on the identity document — printed on certificates.
  legalName          String          @map("legal_name")
  displayName        String?         @map("display_name")
  phoneE164          String?         @map("phone_e164")
  addressLine1       String?         @map("address_line1")
  addressLine2       String?         @map("address_line2")
  city               String?
  state              String?
  postalCode         String?         @map("postal_code")
  countryCode        String?         @map("country_code") @db.Char(2)
  timezone           String?
  organisation       String?
  jobTitle           String?         @map("job_title")
  industry           String?
  experienceBand     String?         @map("experience_band")
  linkedinUrl        String?         @map("linkedin_url")
  idType             IdDocumentType? @map("id_type")
  /// AES-256-GCM, application-level (src/modules/identity/profile-crypto.ts).
  /// The clear number is never stored, logged or audited.
  idNumberCiphertext String?         @map("id_number_ciphertext")
  idNumberLast4      String?         @map("id_number_last4")
  nationalityCode    String?         @map("nationality_code") @db.Char(2)
  dateOfBirth        DateTime?       @map("date_of_birth") @db.Date
  marketingConsentAt DateTime?       @map("marketing_consent_at") @db.Timestamptz(6)
  heardAbout         String?         @map("heard_about")
  /// Interim store for the avatar until object storage is decided (ADR-008):
  /// browser-resized, ≤ 300 KB. Served only through the session-gated route.
  photo              Bytes?
  photoMime          String?         @map("photo_mime")
  photoUpdatedAt     DateTime?       @map("photo_updated_at") @db.Timestamptz(6)
  /// Set when every field required before a paid registration is present.
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Milestone 5b — Reviews (LEARNER_FEEDBACK_REQUIREMENTS.md §6/§13;
// MILESTONE_5B_EXECUTION_PLAN.md §2). One review per registration = per
// certificate (founder decision). Public only when approved + consented +
// visible — the single visibility function in src/modules/reviews.
// ─────────────────────────────────────────────────────────────────────────────

enum ReviewKind {
  registration
  diagnostic

  @@map("review_kind")
}

enum ReviewCategory {
  programme_experience
  course_content
  certification_process
  user_experience
  technical_issue
  other

  @@map("review_category")
}

enum ReviewModeration {
  pending
  approved
  rejected

  @@map("review_moderation")
}

enum ReviewVisibility {
  visible
  hidden

  @@map("review_visibility")
}

model Review {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Null only for `kind = diagnostic`. Unique: one review per registration.
  registrationId      String?            @unique @map("registration_id") @db.Uuid
  registration        Registration?      @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  programmeId         String             @map("programme_id") @db.Uuid
  programme           Programme          @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  offeringId          String?            @map("offering_id") @db.Uuid
  offering            ScheduledOffering? @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  kind                ReviewKind
  /// Plain text, 20–2000 chars; rendered as text, never as HTML.
  body                String
  rating              Int?               @db.SmallInt
  category            ReviewCategory?
  consentPublic       Boolean            @default(false) @map("consent_public")
  consentPhoto        Boolean            @default(false) @map("consent_photo")
  moderationStatus    ReviewModeration   @default(pending) @map("moderation_status")
  visibilityStatus    ReviewVisibility   @default(visible) @map("visibility_status")
  moderatedByUserId   String?            @map("moderated_by_user_id") @db.Uuid
  moderatedAt         DateTime?          @map("moderated_at") @db.Timestamptz(6)
  moderationNote      String?            @map("moderation_note")
  /// The name shown publicly, captured at submission (a later profile change
  /// never silently alters a published review).
  displayNameSnapshot String             @map("display_name_snapshot")
  submittedAt         DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  editedAt            DateTime?          @map("edited_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([moderationStatus, visibilityStatus, consentPublic, submittedAt])
  @@index([userId])
  @@index([programmeId, submittedAt])
  @@map("reviews")
}

/// The ONLY place a provider subject appears (condition 3). A provider change
/// rewrites this table and nothing else.
model AuthIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

/// Launch roles (SECURITY_ARCHITECTURE §3.1, DR-02 terminology).
enum UserRoleName {
  participant
  expert
  assessor
  org_admin
  platform_admin

  @@map("user_role_name")
}

enum RoleScopeType {
  platform
  organisation
  offering

  @@map("role_scope_type")
}

/// Scoped RBAC — never a role column on users (ADR-020). Revocation is a
/// state on the row, not a delete, so the history is kept.
model UserRole {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  role            UserRoleName
  scopeType       RoleScopeType @map("scope_type")
  /// Null only when scopeType = platform.
  scopeId         String?       @map("scope_id") @db.Uuid
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String?       @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?       @map("revoked_by_user_id") @db.Uuid

  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@map("user_roles")
}

/// INSERT-ONLY (ADR-022). Written in the same transaction as the change it
/// describes. No code path updates or deletes a row.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null = the system itself.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

enum OutboundEmailStatus {
  queued
  sent
  failed

  @@map("outbound_email_status")
}

/// Durable record of every email the system decides to send. Nothing is sent
/// without a row (ADR-015 spirit: retryable and visible, never lost).
model OutboundEmail {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail           String              @map("to_email")
  templateKey       String              @map("template_key")
  subject           String
  textBody          String              @map("text_body")
  status            OutboundEmailStatus @default(queued)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  providerMessageId String?             @map("provider_message_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("outbound_emails")
}

/// Recorded acceptance of a PUBLISHED legal document version. Never written
/// when no version is published (MILESTONE_2_EXECUTION_PLAN.md §6.9).
model Consent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  documentKey     String   @map("document_key")
  documentVersion String   @map("document_version")
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  @@unique([userId, documentKey, documentVersion])
  @@map("consents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Milestone 3 — Catalogue & public portal (MILESTONE_3_EXECUTION_PLAN.md §5).
// ADR-043 concepts as data; ADR-023 expansion shape (domain_id, level,
// sort_order, version present and inert). `Json` columns hold EDITORIAL
// structures that are rendered, never queried.
// ─────────────────────────────────────────────────────────────────────────────

/// Display attribute only (DR-01: one credential, no ladder). Never a gate.
enum ProgrammeLevel {
  foundation
  practitioner
  architect
  executive
  builder
  mentorship

  @@map("programme_level")
}

enum ProgrammeStatus {
  published
  unlisted
  retired

  @@map("programme_status")
}

/// A designed, expert-led learning experience — the thing a person chooses.
model Programme {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId         String          @map("domain_id") @db.Uuid
  domain           Domain          @relation(fields: [domainId], references: [id], onDelete: Restrict)
  slug             String          @unique
  title            String
  subtitle         String
  level            ProgrammeLevel
  status           ProgrammeStatus @default(unlisted)
  flagship         Boolean         @default(false)
  durationLabel    String          @map("duration_label")
  prerequisites    String
  /// Delivery labels as published (e.g. "Live online", "Face-to-face").
  formats          Json
  certificateLabel String          @map("certificate_label")
  audienceSummary  String          @map("audience_summary")
  summary          String
  valueProposition String          @map("value_proposition")
  /// Editorial sections: highlights, whoShouldAttend, rationale, outcomes,
  /// outcomeGroups, included, pedagogy, benefits, careerPaths, methodology,
  /// valueStack, valueStackTotal, related, externalResources,
  /// mentorshipPackages.
  content          Json
  sortOrder        Int             @default(0) @map("sort_order")
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  modules         ProgrammeModule[]
  formatsDelivery DeliveryFormat[]
  prices          ProgrammePrice[]
  experts         ProgrammeExpert[]
  offerings       ScheduledOffering[]
  enquiries       Enquiry[]
  orders          Order[]
  reviews         Review[]
  certificates    Certificate[]

  @@index([domainId])
  @@index([status, sortOrder])
  @@map("programmes")
}

model ProgrammeModule {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId String    @map("programme_id") @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String?
  points      Json?

  @@unique([programmeId, position])
  @@map("programme_modules")
}

/// Pace variants of a programme (Bootcamp / Accelerator / Mastery).
model DeliveryFormat {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId    String    @map("programme_id") @db.Uuid
  programme      Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  code           String
  name           String
  badge          String?
  durationLabel  String    @map("duration_label")
  scheduleLabel  String    @map("schedule_label")
  totalTimeLabel String    @map("total_time_label")
  bestFor        Json      @map("best_for")
  position       Int

  offerings ScheduledOffering[]

  @@unique([programmeId, code])
  @@map("delivery_formats")
}

/// Fee rows per training (M12 WP1, founder 2026-09-26 — four rows):
///   malaysia          Malaysia, NOT via HRD Corp — the card price a Malaysian
///                     participant is charged at checkout (L6)
///   malaysia_hrdcorp  Malaysia via HRD Corp — display only; claimed through
///                     the employer, never charged by Stripe (L5)
///   pakistan          paid through the local partner (no card)
///   international     "Rest of the world" — card in USD
enum PriceRegion {
  malaysia
  pakistan
  international
  malaysia_hrdcorp

  @@map("price_region")
}

/// Published regional prices — data, never constants. Amounts in minor units.
model ProgrammePrice {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId      String      @map("programme_id") @db.Uuid
  programme        Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  region           PriceRegion
  currency         String      @db.Char(3)
  listAmountMinor  BigInt      @map("list_amount_minor")
  offerAmountMinor BigInt      @map("offer_amount_minor")
  offerLabel       String      @map("offer_label")
  offerName        String      @map("offer_name")
  validFrom        DateTime?   @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime?   @map("valid_to") @db.Timestamptz(6)
  /// "Minimum 25 participants" — data, not presentation JSON (M12 L4).
  minParticipants  Int?        @map("min_participants")
  /// Region note shown under the figure ("no online option in Malaysia").
  note             String?

  @@unique([programmeId, region])
  @@map("programme_prices")
}

/// The trainer / practitioner — a real role with a public profile (DR-02).
model Expert {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Linked when the person registers; null until then.
  userId               String?  @map("user_id") @db.Uuid
  slug                 String   @unique
  name                 String
  roleTitle            String   @map("role_title")
  location             String
  headline             String
  experienceLine       String   @map("experience_line")
  summary              String
  photoPath            String   @map("photo_path")
  expertise            Json
  /// about, background, specialisations, careerAchievements, books,
  /// frameworks, frameworksUrl, podcast, communityImpact, socialLinks,
  /// technologies, certifications, education, linkedin, mediumProfile.
  profile              Json
  hrdCorpAccreditation Json?    @map("hrd_corp_accreditation")
  published            Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  programmes    ProgrammeExpert[]
  leadOfferings ScheduledOffering[]

  @@map("experts")
}

/// Expert association (ADR-043).
model ProgrammeExpert {
  programmeId String    @map("programme_id") @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  expertId    String    @map("expert_id") @db.Uuid
  expert      Expert    @relation(fields: [expertId], references: [id], onDelete: Restrict)
  role        String    @default("lead")

  @@id([programmeId, expertId])
  @@map("programme_experts")
}

enum DeliveryModality {
  live_online
  face_to_face
  corporate_private

  @@map("delivery_modality")
}

enum OfferingStatus {
  planned
  open
  full
  completed
  cancelled

  @@map("offering_status")
}

/// A dated instance of a programme — the thing a person registers for.
/// ZERO rows until a real date exists (DR-02 §4.1). Capacity is named, not
/// enforced (ADR-043); the hold mechanism is M4's.
model ScheduledOffering {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programmeId      String           @map("programme_id") @db.Uuid
  programme        Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  deliveryFormatId String?          @map("delivery_format_id") @db.Uuid
  deliveryFormat   DeliveryFormat?  @relation(fields: [deliveryFormatId], references: [id], onDelete: Restrict)
  modality         DeliveryModality
  location         String?
  timezone         String
  startsOn         DateTime         @map("starts_on") @db.Date
  endsOn           DateTime         @map("ends_on") @db.Date
  scheduleNote     String?          @map("schedule_note")
  capacity         Int?
  status           OfferingStatus   @default(planned)
  /// Private-cohort scope. Plain UUID until `organisations` exists (M8).
  organisationId   String?          @map("organisation_id") @db.Uuid
  leadExpertId     String?          @map("lead_expert_id") @db.Uuid
  leadExpert       Expert?          @relation(fields: [leadExpertId], references: [id], onDelete: Restrict)
  /// ADR-044: the portal holds joining details; delivery is external.
  /// Participant-only (M5); never rendered publicly.
  joiningDetails   String?          @map("joining_details")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders        Order[]
  registrations Registration[]
  reviews       Review[]
  certificates  Certificate[]

  @@index([programmeId, status, startsOn])
  @@map("scheduled_offerings")
}

model FaqEntry {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupTitle String  @map("group_title")
  position   Int
  question   String
  answer     String
  href       String?
  hrefLabel  String? @map("href_label")
  tbc        Boolean @default(false)
  published  Boolean @default(true)

  @@unique([groupTitle, position])
  @@map("faq_entries")
}

model DiagnosticQuestion {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String @unique
  domainId String @map("domain_id") @db.Uuid
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  position Int    @unique
  scenario String
  /// string[]; "I'm not sure" is appended by the UI, never stored.
  options  Json

  @@map("diagnostic_questions")
}

enum EnquiryKind {
  general
  organisation
  programme_interest

  @@map("enquiry_kind")
}

enum EnquiryStatus {
  new
  replied
  closed

  @@map("enquiry_status")
}

/// Contact / register-interest submissions — persistent from day one.
model Enquiry {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         EnquiryKind
  name         String
  email        String
  organisation String?
  message      String
  programmeId  String?       @map("programme_id") @db.Uuid
  programme    Programme?    @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  sourcePath   String        @map("source_path")
  status       EnquiryStatus @default(new)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("enquiries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Milestone 4 — Registration & payment (MILESTONE_4_EXECUTION_PLAN.md §5).
// OUR records are authoritative for entitlement (ADR-014); a registration
// exists only after a verified Stripe event.
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  pending
  paid
  expired
  failed
  cancelled
  refunded
  partially_refunded

  @@map("order_status")
}

/// Milestone 6 (E14): what a paid order produces. `registration` → a seat
/// (M4); `certificate_renewal` → 12 more months on an existing certificate.
enum OrderKind {
  registration
  certificate_renewal

  @@map("order_kind")
}

model Order {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String            @map("user_id") @db.Uuid
  user                    User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  offeringId              String            @map("offering_id") @db.Uuid
  offering                ScheduledOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  programmeId             String            @map("programme_id") @db.Uuid
  programme               Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  status                  OrderStatus       @default(pending)
  /// M6: a renewal order keeps the original registration's offering and
  /// programme, so neither column becomes nullable. Capacity counting and the
  /// duplicate checks look at `registration` orders only.
  kind                    OrderKind         @default(registration)
  certificateId           String?           @map("certificate_id") @db.Uuid
  certificate             Certificate?      @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  region                  PriceRegion
  currency                String            @db.Char(3)
  amountMinor             BigInt            @map("amount_minor")
  stripeCheckoutSessionId String?           @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?           @map("stripe_payment_intent_id")
  expiresAt               DateTime          @map("expires_at") @db.Timestamptz(6)
  paidAt                  DateTime?         @map("paid_at") @db.Timestamptz(6)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment      Payment?
  registration Registration?
  renewal      CertificateRenewal?

  @@index([userId, createdAt])
  @@index([offeringId, status, expiresAt])
  @@map("orders")
}

enum PaymentStatus {
  succeeded
  refunded
  partially_refunded

  @@map("payment_status")
}

model Payment {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String        @unique @map("order_id") @db.Uuid
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider                String        @default("stripe")
  providerPaymentIntentId String        @unique @map("provider_payment_intent_id")
  providerChargeId        String?       @map("provider_charge_id")
  amountMinor             BigInt        @map("amount_minor")
  currency                String        @db.Char(3)
  receiptUrl              String?       @map("receipt_url")
  /// Stripe's non-recoverable processing fee for this charge, in minor units
  /// of the charge currency (converted from the settlement currency when they
  /// differ). Null until the balance transaction is available. Refunds are
  /// net of it (founder decision 2026-09-22).
  providerFeeMinor        BigInt?       @map("provider_fee_minor")
  status                  PaymentStatus @default(succeeded)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  refunds Refund[]

  @@map("payments")
}

enum RefundReason {
  participant_cancellation
  academy_cancellation
  manual

  @@map("refund_reason")
}

enum RefundStatus {
  pending
  succeeded
  failed

  @@map("refund_status")
}

model Refund {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRefundId  String?      @unique @map("provider_refund_id")
  amountMinor       BigInt       @map("amount_minor")
  percent           Int
  reason            RefundReason
  status            RefundStatus @default(pending)
  requestedByUserId String?      @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("refunds")
}

enum RegistrationStatus {
  confirmed
  cancelled
  transferred

  @@map("registration_status")
}

/// A person's place in an offering (ADR-043). Created ONLY by the paid-webhook
/// transaction (plan §6.1).
model Registration {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                      String             @map("user_id") @db.Uuid
  user                        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  offeringId                  String             @map("offering_id") @db.Uuid
  offering                    ScheduledOffering  @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  orderId                     String             @unique @map("order_id") @db.Uuid
  order                       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status                      RegistrationStatus @default(confirmed)
  transferUsed                Boolean            @default(false) @map("transfer_used")
  transferredToRegistrationId String?            @map("transferred_to_registration_id") @db.Uuid
  cancelledAt                 DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancellationRefundPercent   Int?               @map("cancellation_refund_percent")
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  review      Review?
  certificate Certificate?

  @@index([offeringId, status])
  @@index([userId, status])
  @@map("registrations")
}

enum StripeEventStatus {
  received
  processed
  ignored
  failed

  @@map("stripe_event_status")
}

/// Every webhook event, stored BEFORE processing — idempotency + audit.
model StripeEvent {
  id          String            @id
  type        String
  status      StripeEventStatus @default(received)
  payload     Json
  error       String?
  receivedAt  DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?         @map("processed_at") @db.Timestamptz(6)

  @@index([type, receivedAt])
  @@map("stripe_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Milestone 6 — Certificate of Completion (MILESTONE_6_EXECUTION_PLAN.md §4;
// founder approved E1–E14 on 2026-09-22). NOT the earned credential (DR-01).
// Status (active · renewal due · expired · revoked) is COMPUTED on read from
// `expires_on`, `revoked_at` and today's MYT calendar date — no status column,
// no job (R-L1).
// ─────────────────────────────────────────────────────────────────────────────

/// One per completed registration. Issued in the same transaction as the
/// administrator's completion record (E2); the ID is never reused (R-D3).
model Certificate {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable `DAA-YYYY-XXXX-XXXX`, 31-symbol alphabet, server-generated
  /// from a cryptographic source; uniqueness enforced here, not by hope.
  certificateId    String            @unique @map("certificate_id")
  registrationId   String            @unique @map("registration_id") @db.Uuid
  registration     Registration      @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  userId           String            @map("user_id") @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  programmeId      String            @map("programme_id") @db.Uuid
  programme        Programme         @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  offeringId       String            @map("offering_id") @db.Uuid
  offering         ScheduledOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  /// Snapshots: a later profile or catalogue edit must never rewrite a printed
  /// certificate. `holder_name` is correctable by an administrator only (E8).
  holderName       String            @map("holder_name")
  /// Lower-cased, accent-stripped copy of `holder_name` for word-prefix search.
  holderNameSearch String            @map("holder_name_search")
  programmeTitle   String            @map("programme_title")
  formatName       String            @map("format_name")
  completedOn      DateTime          @map("completed_on") @db.Date
  issuedOn         DateTime          @map("issued_on") @db.Date
  /// Last day the certificate is active (inclusive), MYT calendar date.
  expiresOn        DateTime          @map("expires_on") @db.Date
  /// Opt-in to public NAME search (E3). ID lookup works regardless.
  listed           Boolean           @default(false)
  listedChangedAt  DateTime?         @map("listed_changed_at") @db.Timestamptz(6)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId  String?           @map("revoked_by_user_id") @db.Uuid
  revocationReason String?           @map("revocation_reason")
  issuedByUserId   String            @map("issued_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  renewals CertificateRenewal[]
  orders   Order[]

  @@index([userId])
  @@index([listed, holderNameSearch])
  @@index([expiresOn])
  @@map("certificates")
}

/// Insert-only history of the renewal fee (R-F1/R-F2). The fee in force is
/// the newest row whose `effective_from` is not in the future. Seeded at
/// USD 10.00 (founder, 2026-09-20; E4). `created_by_user_id` is null for the
/// seed row only.
model CertificateFeeSetting {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amountMinor     Int      @map("amount_minor")
  currency        String   @db.Char(3)
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(6)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  renewals CertificateRenewal[]

  @@index([effectiveFrom])
  @@map("certificate_fee_settings")
}

/// Insert-only (ADR-022). Written ONLY by the paid-webhook transaction; the
/// certificate's `expires_on` moves in the same transaction (C3/C4).
model CertificateRenewal {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateId     String                @map("certificate_id") @db.Uuid
  certificate       Certificate           @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  orderId           String                @unique @map("order_id") @db.Uuid
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  feeSettingId      String                @map("fee_setting_id") @db.Uuid
  feeSetting        CertificateFeeSetting @relation(fields: [feeSettingId], references: [id], onDelete: Restrict)
  previousExpiresOn DateTime              @map("previous_expires_on") @db.Date
  newExpiresOn      DateTime              @map("new_expires_on") @db.Date
  amountMinor       BigInt                @map("amount_minor")
  currency          String                @db.Char(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([certificateId, createdAt])
  @@map("certificate_renewals")
}
