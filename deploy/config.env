# =============================================================================
# Training & Certification Portal — deployment framework configuration
# (MILESTONE_11_EXECUTION_PLAN.md §2 item 2; modelled on eCard's config.env)
# =============================================================================
# NAMES AND ADDRESSES ONLY. No secret ever belongs in this file (ADR-030).
# Anything the scripts can discover at run time (git commit, local versions,
# tool paths) is discovered and does not belong here either.
#
# Per-machine overrides go in deploy/config.local.env (gitignored) — the same
# variable names; that file is sourced after this one.
#
# Values marked <…> are placeholders: 00-discovery.sh and 09-audit.sh refuse
# to proceed while any placeholder remains. Fill them the day Phase B (K5,
# K13) is decided; until then only --dry-run against a throwaway
# config.local.env is possible, which is exactly what V2 requires.
# =============================================================================

FRAMEWORK_VERSION="p4tc-deploy 2.0 (2026-09-27 — rsync + PM2, no Docker/registry)"

# --- Server (K2 reversed 2026-09-27: one DigitalOcean Droplet, PM2 + Caddy,
# no Docker, no registry — see ARCHITECTURE_DECISION_REGISTER.md ADR-046 K2/
# K6/K9 supersession). K5 region re-decided 2026-09-27: NYC1, not SGP1 — the
# founder's explicit instruction while creating the Droplet; does not affect
# the already-resolved J1 residency answer (none of the seven inputs binds
# this deployment to a jurisdiction) — see ADR-032. ---------------------------
SERVER_HOST="198.199.67.177"          # p4tc-production, Ubuntu 24.04, NYC1
SERVER_USER="deploy"
SSH_OPTS="-o ConnectTimeout=15 -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

# --- Domain (K13) — interim sslip.io hostname from the Droplet's IP; no
# domain registered yet. A real, resolvable DNS name Caddy can get a genuine
# Let's Encrypt certificate for, swappable for a real domain later with a
# config change only (deploy/README.md). ---------------------------------------
DOMAIN="198-199-67-177.sslip.io"
PRODUCTION_URL="https://${DOMAIN}"

# --- Release artifact (K6 reversed: CI still builds and PROVES every tag,
# but ships the built output as a GitHub Actions artifact, not a Docker
# image — no registry anywhere in this framework) ----------------------------
GITHUB_REPO="mustafaisonline/Portal4TrainingCertification"
RELEASE_WORKFLOW="release.yml"
CI_WORKFLOW="ci.yml"
RELEASES_KEEP=3               # release directories kept on the server for instant rollback
NODE_MAJOR=24
PM2_APP_NAME="p4tc-production"

# --- Git source of a deploy ---------------------------------------------------
# A deploy is a TAG on a commit that is (1) on this branch of this remote and
# (2) built by the release workflow. The working tree must be clean.
DEPLOY_GIT_REMOTE="origin"
DEPLOY_GIT_REMOTE_BRANCH="main"

# --- Server paths (created by 10-server-bootstrap-serverscript.sh) -----------
REMOTE_ETC="/etc/p4tc"                 # env file, release marker file, HMAC key (root-owned)
REMOTE_OPT="/opt/p4tc"                 # framework copy, backups, incoming bundles, releases, markers
REMOTE_DEPLOY_DIR="${REMOTE_OPT}/deploy"
REMOTE_BACKUP_ROOT="${REMOTE_OPT}/backups"
REMOTE_STAGING_INCOMING="${REMOTE_OPT}/staging"   # governance bundles + release tarball land here (deploy-writable)
REMOTE_RELEASES_ROOT="${REMOTE_OPT}/releases"     # releases/<tag>/ + releases/current -> <tag> (root-owned)
REMOTE_MARKERS_ROOT="${REMOTE_OPT}/markers"       # .deployed-* per environment (root-owned)
DEPLOY_WRAPPER="/usr/local/bin/p4tc-deploy"       # the only sudo entry point on the server

# --- Environment (staging DROPPED 2026-09-27 — see ADR-029's supersession
# note; only production is provisioned) --------------------------------------
# One env file, one release lineage, one port Caddy proxies to, one database.
PRODUCTION_PORT=3000
SANDBOX_DB_NAME="p4tc_migration"       # migration sandbox (03) — restored from the latest dump
ADMIN_DB_NAME="defaultdb"              # database to connect to for CREATE DATABASE (DO managed: defaultdb; plain PostgreSQL: postgres)

# --- Destructive migrations (ADR-029 RED gate) --------------------------------
# The sandbox (03) refuses any pending migration whose SQL drops a table,
# column, index, schema or constraint, or truncates — unless its folder name
# is listed here. Listing one records the founder's explicit approval in git.
# Space-separated, e.g. "20261001120000_drop_legacy_table"
DESTRUCTIVE_MIGRATIONS_APPROVED=""

# --- Backups (K10: managed PITR primary + this second layer) ----------------
BACKUP_KEEP=7                          # newest N packages kept on the server
BACKUP_MAX_AGE_HOURS=30                # audit warns when the newest backup is older

# --- Governance --------------------------------------------------------------
GOVERNANCE_HMAC_KEY_FILE=".governance-hmac.key"   # relative to deploy/; gitignored; copied once from the server
GOVERNANCE_TOKEN_TTL_SECONDS=1800

# --- Timeouts (seconds) — every task must pass, fail or time out ------------
CURL_TIMEOUT_SEC=30
SSH_CONNECT_TIMEOUT_SEC=15
GATE_TYPECHECK_TIMEOUT_SEC=300
GATE_VITEST_TIMEOUT_SEC=600
GATE_BUILD_TIMEOUT_SEC=600
GATE_PLAYWRIGHT_TIMEOUT_SEC=1200
GATE_AUDIT_TIMEOUT_SEC=120
DEPLOY_PROMOTE_TIMEOUT_SEC=1200
HEALTH_WAIT_TIMEOUT_SEC=90
VALIDATION_TIMEOUT_SEC=300
