{
  "name": "data-ai-academy-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data & AI Academy — Training & Certification Portal. Production application (repository root). The wireframe lives in project-artifacts/mockup and is kept for comparison.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-transform-types --import ./scripts/register-alias.mjs prisma/seed.ts",
    "email:grandfather": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/email-grandfather.ts",
    "email:test": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/email-test.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:grant": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/grant-admin.ts",
    "learning:import": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/ingest-datapedia.ts",
    "learning:import-questions": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/import-questions.ts",
    "unlock:relabel": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/relabel-unlock-setting.ts",
    "stripe:check": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/stripe-check.ts",
    "knowledge-check:approve-all": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/bulk-review-questions.ts",
    "interview:approve-all": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/approve-interview-questions.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "1.7.5",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "mammoth": "^1.13.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
