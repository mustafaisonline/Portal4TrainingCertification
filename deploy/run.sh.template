#!/usr/bin/env bash
# deploy/run.sh.template — rendered into each release directory as run.sh by
# deploy/lib/server-promote.sh's unpack_release() ({{ENV_FILE}}, {{PORT}}
# substituted). Sources the root-owned env file (ADR-030: values are typed
# once on the server, never transmitted through this framework) into the
# process environment, then execs `next start` — this is PM2's equivalent of
# Docker Compose's `env_file:` directive, which PM2 itself has no version of.
set -euo pipefail
set -a
# shellcheck disable=SC1091
. "{{ENV_FILE}}"
set +a
exec node_modules/.bin/next start -p "{{PORT}}"
