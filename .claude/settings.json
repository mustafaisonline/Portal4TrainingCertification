{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__reference-material__write_file",
      "mcp__reference-material__edit_file",
      "mcp__reference-material__move_file",
      "mcp__reference-material__create_directory"
    ]
  },
  "enabledMcpjsonServers": [
    "reference-material"
  ],
  "agent": "buddy",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "statusMessage": "guard: checking command"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py\"",
            "timeout": 10,
            "statusMessage": "guard: checking file"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "head"
  }
}
