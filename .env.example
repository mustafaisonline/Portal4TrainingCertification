# Copy to .env.local (gitignored). Names only — never commit values (ADR-030).

# PostgreSQL — the sole source of truth (ADR-005).
# Local development: the Homebrew PostgreSQL 16 service, or the Compose
# container in compose.yaml (both work; see docs/execution/M1 completion report).
DATABASE_URL="postgresql://USER@localhost:5432/p4tc_dev"
# A SEPARATE database for automated tests. Vitest refuses to run if this is
# unset or equals DATABASE_URL — tests must never touch the dev database.
DATABASE_URL_TEST="postgresql://USER@localhost:5432/p4tc_test"
# ⚠ The database's session timezone MUST be UTC (compose init sets it; on any
# other PostgreSQL run: ALTER DATABASE <name> SET timezone TO 'UTC'). Otherwise
# every timestamp the app writes is shifted by the zone offset — see
# tests/integration/timestamps.test.ts. Production must set this too.

# Base URL of this application (used for absolute links in email, verification
# URLs and the Playwright baseURL). Local default:
APP_BASE_URL="http://localhost:3100"

# ── Identity & access (Milestone 2) ──────────────────────────────────────────
# Signing/encryption key for sessions and tokens. Generate per environment:
#   openssl rand -base64 32
# Never share one between environments (ADR-030).
BETTER_AUTH_SECRET=""

# Email transport: "log" records every message in outbound_emails and logs
# only recipient/template/subject (no links). "resend" / "postmark" are
# recognised but refuse to start until ADR-015 is decided and keys exist.
EMAIL_TRANSPORT="log"

# Consent gate. Registration stays CLOSED until the published version of each
# legal document is named here (JSON). Set this only when the founder has
# actually published the Terms of service and Privacy policy, e.g.
#   LEGAL_DOCUMENT_VERSIONS='{"terms":"2026-10-01","privacy":"2026-10-01"}'
# Leave unset otherwise. Local development may set a dummy value.
# LEGAL_DOCUMENT_VERSIONS=''

# Where new contact-form enquiries are announced (through the outbox). Unset =
# enquiries are recorded in the database only.
# ENQUIRY_NOTIFY_EMAIL=""

# ── Registration & payment (Milestone 4) — Stripe (ADR-014; founder holds the account) ──
# TEST-mode keys for local work; LIVE keys only in the production secret store.
#   Secret key: Stripe Dashboard → Developers → API keys → "Secret key" (sk_test_…)
#   Webhook signing secret: `stripe listen --forward-to localhost:3100/api/stripe/webhook`
#   prints whsec_… (local), or Developers → Webhooks → endpoint → "Signing secret".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── User profile (Milestone 5a) ──
# AES-256-GCM key for the ID-number column: `openssl rand -base64 32`. Per
# environment; rotating it means re-encrypting rows. Never commit a value.
PROFILE_ENCRYPTION_KEY=""

# ── Renewal reminders (Milestone 7) ──
# Bearer token for POST /api/jobs/certificate-reminders, called by the
# scheduler the hosting decision provides (Vercel Cron, system cron, CI
# schedule). `openssl rand -base64 32`. Unset = the endpoint answers 503.
JOBS_SECRET=""

# ── Production (Milestone 9) ─────────────────────────────────────────────────
# src/config/env.ts is run by instrumentation.ts at server start. With
# NODE_ENV=production the server REFUSES TO START unless every one of these
# is present and well-formed (names only here; values in the host's secret
# store — ADR-030). In development the same check prints one warning line.
#   DATABASE_URL            postgres:// or postgresql://
#   BETTER_AUTH_SECRET      ≥ 32 characters
#   APP_BASE_URL            https:// in production
#   PROFILE_ENCRYPTION_KEY  base64 of exactly 32 bytes
#   EMAIL_TRANSPORT         log | resend | postmark
#   JOBS_SECRET             ≥ 16 characters
#   STRIPE_SECRET_KEY       sk_live_… (both Stripe values together, or neither)
#   STRIPE_WEBHOOK_SECRET   whsec_…
# Warning only (never fatal): LEGAL_DOCUMENT_VERSIONS unset = registration
# closed, a supported launch state; a set but malformed value IS fatal.
# See docs/operations/DEPLOYMENT_RUNBOOK.md for the per-host table.
# APP_ENV=test is set ONLY by playwright.config.ts when the suite runs against
# a production build (PLAYWRIGHT_SERVER=start); it relaxes the fail-fast
# validation to warnings. Never set it on a deployed environment.
