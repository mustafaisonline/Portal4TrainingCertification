# deploy/Caddyfile.example — rendered to /etc/caddy/Caddyfile by the server
# bootstrap ({{DOMAIN}}, {{PRODUCTION_PORT}} substituted). Caddy terminates
# TLS with automatic certificates (K8) and forwards to the PM2-managed app,
# which binds 127.0.0.1 only. X-Forwarded-* headers are set by Caddy by
# default; the application's own security headers (next.config.ts) pass
# through untouched.
#
# Staging DROPPED 2026-09-27 (ADR-029 supersession) — this file only ever
# had one vhost worth keeping; the staging.{{DOMAIN}} block is gone, not just
# unused.

{{DOMAIN}} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:{{PRODUCTION_PORT}}
	log {
		output file /var/log/caddy/production.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

www.{{DOMAIN}} {
	redir https://{{DOMAIN}}{uri} permanent
}

# Legacy interim host (CR-2026-10-01-2136, cut over 2026-10-02): permanent redirect,
# so certificate QR codes and links issued against the old address keep working.
198-199-67-177.sslip.io, www.198-199-67-177.sslip.io {
	redir https://{{DOMAIN}}{uri} permanent
}
